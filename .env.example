# Telegram bot that receives orders from the website form.
# 1. Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# 2. Chat ID(s) that receive orders. Several IDs can be comma-separated
#    (e.g. your personal chat and a managers' group: 123456789,-1001234567890).
TELEGRAM_CHAT_ID=

# Production address of the site (no trailing slash) — used for SEO:
# canonical URL, sitemap.xml, robots.txt, social previews, structured data.
NEXT_PUBLIC_SITE_URL=
